# ─────────────────────────────────────────────────────────────────────────
# FamilySpot Growth — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# --- GA4 (web + blog + iOS + Android, one property) ---
# Numeric property ID from GA4 Admin → Property Settings (e.g. 123456789).
GA4_PROPERTY_ID=
# Optional: the blog lives in a separate GA4 property. Set its property ID to
# include the blog as its own "Blog" origin. The service account must also be a
# Viewer on this property.
GA4_BLOG_PROPERTY_ID=

# The FULL JSON of the Google Cloud service-account key, on one line.
# Paste the entire { ... } contents of the downloaded key file here.
# In the GA4 property, this service account's email must be added as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Weekly email (Resend) ---
RESEND_API_KEY=
# Verified sender in Resend (e.g. insights@mail.familyspot.app)
REPORT_FROM_EMAIL=
# Where the weekly report is sent.
REPORT_TO_EMAIL=tjlannes@gmail.com

# --- AI insights (optional) ---
# If empty, the email falls back to a rule-based summary (no AI narrative).
ANTHROPIC_API_KEY=

# --- Fase 2: Meta (Facebook Page + Instagram) — opcional ---
# Token de página de longa duração (~60 dias — rodar). Lê só os TEUS insights.
META_ACCESS_TOKEN=
# ID da página Facebook (opcional)
META_PAGE_ID=
# ID da conta Instagram Business/Creator (opcional)
META_IG_USER_ID=

# --- Fase 2: lojas (conectores pendentes) ---
# PLAY_PACKAGE_NAME=app.familyspot
# APPSTORE_APP_ID=
# APPSTORE_KEY_ID=
# APPSTORE_ISSUER_ID=
# APPSTORE_PRIVATE_KEY=

# --- Security ---
# Random string. Protects the /api/weekly-report cron endpoint and the dashboard.
CRON_SECRET=
# Password to view the dashboard (simple gate for a private tool).
DASHBOARD_PASSWORD=
